# Copy to deploy/.env on the VM (git-ignored). Variables marked required stop `docker compose` when empty.

# Required. Database password; hex so DATABASE_URL needs no escaping: openssl rand -hex 24
POSTGRES_PASSWORD=
# Required. Signs the OAuth state cookie: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# Required. Fernet key(s) for stored integration tokens, comma-separated for rotation, newest first:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATIONS_KEY=
# Required. Comma-separated emails allowed to sign in (invite-only).
ALLOWED_EMAILS=
# Required. Cloudflare dashboard > Zero Trust > Networks > Tunnels > your tunnel > install connector: the token.
TUNNEL_TOKEN=

# Optional. GitHub OAuth app; callback https://<host>/api/auth/github/callback. Empty hides the login button.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional. Google OAuth client; redirect URI https://<host>/api/auth/google/callback. Empty hides the login button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Slack app credentials (docs/slack.md); Slack is offered only when all three are set.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Optional. Notion public integration (docs/notion.md); offered only when both are set.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
