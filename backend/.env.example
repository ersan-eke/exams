# Copy to backend/.env. Leave a provider's values empty to hide its login button.

# GitHub: Settings > Developer settings > OAuth Apps
#   callback URL: http://localhost:5173/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google: Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
#   authorized redirect URI: http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required outside local dev: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Comma-separated emails allowed to sign in. Empty means anyone can (local dev only); production refuses to start without it.
ALLOWED_EMAILS=

# Slack: api.slack.com/apps > Create New App > From a manifest (docs/slack-app-manifest.yml, see docs/slack.md)
#   OAuth & Permissions > redirect URL (via your tunnel): https://<tunnel>/api/integrations/slack/callback
#   Basic Information > App Credentials: client id, client secret, signing secret
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Encrypts stored integration tokens; comma-separated for rotation, newest first.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATIONS_KEY=
